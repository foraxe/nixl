      "UCX_NET_DEVICES": "RDMA_DEVICE:1",
      "UCX_IB_GID_INDEX": "0"
    }
  },
  "receiver": {
    "shell_prefix": ["kubectl", "-n", "NAMESPACE", "exec", "RECEIVER_POD", "--"],
    "executable": "/PATH/TO/ucx_affine/replay",
    "gpu": 0,
    "cpu": 0,
    "oob_port": 18050,
    "plugin_dir": "/PATH/TO/BASELINE/plugins",
    "identity_files": [
      "/PATH/TO/NIXL/libnixl.so",
      "/PATH/TO/NIXL/libnixl_build.so",
      "/PATH/TO/UCX/lib/libucp.so.0"
    ],
    "env": {
      "LD_LIBRARY_PATH": "/PATH/TO/NIXL:/PATH/TO/UCX/lib:/PATH/TO/CUDA/lib64",
      "UCX_MODULE_DIR": "/PATH/TO/UCX/lib/ucx",
      "UCX_NET_DEVICES": "RDMA_DEVICE:1",
      "UCX_IB_GID_INDEX": "0"
    }
  }
}
