  "gid_index": 0,
  "sender": {
    "shell_prefix": ["kubectl", "-n", "NAMESPACE", "exec", "SENDER_POD", "--"],
    "executable": "/PATH/TO/ucx_affine/replay",
    "gpu": 0,
    "cpu": 0,
    "oob_port": 18040,
    "baseline_plugin_dir": "/PATH/TO/BASELINE/plugins",
    "affine_plugin_dir": "/PATH/TO/AFFINE/plugins",
    "identity_files": [
      "/PATH/TO/NIXL/libnixl.so",
      "/PATH/TO/NIXL/libnixl_build.so",
      "/PATH/TO/UCX/lib/libucp.so.0"
    ],
    "env": {
      "LD_LIBRARY_PATH": "/PATH/TO/NIXL:/PATH/TO/UCX/lib:/PATH/TO/CUDA/lib64",
